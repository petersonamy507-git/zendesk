# Copy to .env and edit. Never commit .env.
ENVIRONMENT=development
DATABASE_URL=mysql+pymysql://helpdesk:CHANGE_ME@127.0.0.1:3306/helpdesk
# Used by `TEST_DB=mysql pytest`; the database name must end in _test (tables are dropped on every run)
TEST_DATABASE_URL=mysql+pymysql://helpdesk:CHANGE_ME@127.0.0.1:3306/helpdesk_test
# Leave empty for the in-process broker (single worker). Set for production multi-worker deployments.
REDIS_URL=
JWT_SECRET=CHANGE_ME_to_a_long_random_string_at_least_32_bytes
CORS_ORIGINS=["http://parley.localhost:5643","http://localhost:5643","http://127.0.0.1:5643"]
FRONTEND_URL=http://parley.localhost:5643
UPLOAD_DIR=storage/uploads
# S3-compatible storage (optional; falls back to local disk)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Outbound email (optional; without it emails are logged and kept in an in-memory outbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=support@parley.local
RUN_INPROCESS_WORKERS=true
# Reverse proxies whose X-Forwarded-For is believed (addresses/CIDRs). Loopback covers the Vite dev proxy and a same-host nginx.
TRUSTED_PROXIES=["127.0.0.1","::1"]
